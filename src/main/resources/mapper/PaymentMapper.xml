<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.homemaker.mapper.PaymentMapper">

    <!-- 基础字段映射 -->
    <sql id="Base_Column_List">
        id, order_id, order_no, amount, status, transaction_id, out_trade_no, pay_time, pay_type, user_id, callback_result, create_time, update_time
    </sql>

    <!-- 根据订单ID查询支付记录 -->
    <select id="selectByOrderId" parameterType="java.lang.Long" resultType="com.homemaker.entity.Payment">
        select
        <include refid="Base_Column_List" />
        from payment_record
        where order_id = #{orderId}
    </select>

    <!-- 根据微信支付交易号查询支付记录 -->
    <select id="selectByTransactionId" parameterType="java.lang.String" resultType="com.homemaker.entity.Payment">
        select
        <include refid="Base_Column_List" />
        from payment_record
        where transaction_id = #{transactionId}
    </select>

    <!-- 根据商户订单号查询支付记录 -->
    <select id="selectByOutTradeNo" parameterType="java.lang.String" resultType="com.homemaker.entity.Payment">
        select
        <include refid="Base_Column_List" />
        from payment_record
        where out_trade_no = #{outTradeNo}
    </select>

</mapper>