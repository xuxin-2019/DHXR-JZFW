<!--login.wxml-->
<view class="container">
  <view class="header">
    <text class="title">完善登录信息</text>
  </view>
  
  <view class="form-container">
    <!-- 用户信息展示 -->
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFit"></image>
      <text class="nickname">{{userInfo.nickName}}</text>
    </view>
    
    <!-- 表单 -->
    <view class="form-group">
      <view class="form-item">
        <text class="label">角色选择 <text class="required">*</text></text>
        <view class="radio-group">
          <radio-group bindchange="onRoleChange">
            <label>
              <radio value="1" checked="{{role === '1'}}"/> 用户
            </label>
            <label>
              <radio value="2" checked="{{role === '2'}}"/> 护工
            </label>
          </radio-group>
        </view>
      </view>
      
      <view class="form-item">
        <text class="label">手机号码 <text class="required">*</text></text>
        <input class="input" type="number" placeholder="请输入手机号码" bindinput="onPhoneChange" value="{{phone}}" maxlength="11"/>
      </view>
      
      <!-- 用户角色显示家庭地址 -->
      <view class="form-item" wx:if="{{role === '1'}}">
        <text class="label">家庭地址 <text class="required">*</text></text>
        <input class="input" placeholder="请输入家庭地址" bindinput="onAddressChange" value="{{address}}"/>
      </view>
      
      <!-- 护工角色显示年龄和服务类型 -->
      <view class="form-item" wx:if="{{role === '2'}}">
        <text class="label">年龄 <text class="required">*</text></text>
        <input class="input" type="number" placeholder="请输入年龄(18-65)" bindinput="onAgeChange" value="{{age}}" maxlength="2"/>
      </view>
      
      <view class="form-item" wx:if="{{role === '2'}}">
        <text class="label">服务类型 <text class="required">*</text></text>
        <picker bindchange="onServiceTypeChange" value="{{serviceTypeIndex}}" range="{{serviceTypes}}" range-key="name">
          <view class="picker">
            {{loadingServiceTypes ? '加载中...' : (serviceTypeName || '请选择服务类型')}}
          </view>
        </picker>
      </view>
    </view>
    
    <!-- 提交按钮 -->
    <button class="submit-btn" bindtap="onSubmit" disabled="{{!canSubmit}}">确认登录</button>
    
    <text class="error-message" wx:if="{{errorMsg}}">{{errorMsg}}</text>
  </view>
</view>