<!--orders.wxml-->
<view class="container">
  <!-- Tab栏 -->
  <view class="tab-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="id"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading && !orderList.length}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!loading && !orderList.length}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <!-- 订单卡片列表 -->
    <view 
      wx:for="{{orderList}}" 
      wx:key="id"
      class="order-card"
      bindtap="onOrderCardTap"
      data-id="{{item.id}}"
    >
      <!-- 订单头部：订单编号和状态 -->
      <view class="order-header">
        <view class="order-no">
          <text class="order-label">订单编号：</text>
          <text class="order-value">{{item.orderNo}}</text>
        </view>
        <view class="order-status" style="background-color: {{item.statusInfo.color}};">
          <text class="status-text">{{item.statusInfo.text}}</text>
        </view>
      </view>

      <!-- 订单内容：服务类型和金额 -->
      <view class="order-content">
        <view class="content-row">
          <text class="content-label">服务类型：</text>
          <text class="content-value">{{item.serviceName || item.serviceType}}</text>
        </view>
        <!-- 已接单状态下显示护工电话按钮将在底部显示 -->
        <view class="content-row">
          <text class="content-label">服务金额：</text>
          <text class="content-value price">¥{{item.amount || item.price}}</text>
        </view>
      </view>

      <!-- 订单时间信息 -->
      <view class="order-time">
        <view class="time-row">
          <text class="time-label">服务时间：</text>
          <text class="time-value">{{item.serviceTimeFormatted}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">服务时长：</text>
          <text class="time-value">{{item.serviceDurationFormatted}}</text>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <text class="order-date">{{item.createTime ? item.createTime.split(' ')[0] : ''}}</text>
        <!-- 所有状态下显示联系客服按钮 -->
        <view class="action-buttons">
          <view class="contact-btn" data-phone="13311090981" bindtap="contactCaregiver">联系客服</view>
        </view>
        <!-- 已完成状态下显示去评价和申请退款按钮 -->
        <view wx:if="{{item.status === 5 || (item.statusInfo && item.statusInfo.code === 5)}}" class="action-buttons">
          <view class="review-btn" data-id="{{item.orderNo}}" data-nurseid="{{item.nurseId}}" bindtap="onReviewButtonTap">去评价</view>
          <view class="refund-btn" data-id="{{item.orderNo}}" bindtap="onRefundButtonTap">申请退款</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中指示器 -->
  <view class="refresh-indicator" wx:if="{{refreshing}}">
    <text class="refresh-text">刷新中...</text>
  </view>
  
  <!-- 加载更多指示器 -->
  <view class="load-more-indicator" wx:if="{{loadingMore}}">
    <text class="load-more-text">加载更多...</text>
  </view>
  
  <!-- 没有更多数据提示 -->
  <view class="no-more-indicator" wx:if="{{!loadingMore && !hasMore && orderList.length}}">
    <text class="no-more-text">没有更多了~</text>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="custom-tab-bar">
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/index/index">
      <view class="tab-icon">🏠</view>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-item active" bindtap="navigateToPage" data-page="pages/orders/orders">
      <view class="tab-icon">📋</view>
      <text class="tab-text">订单</text>
    </view>
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/profile/profile">
      <view class="tab-icon">👤</view>
      <text class="tab-text">我的</text>
    </view>
  </view>
  
  <!-- 评价弹窗 -->
  <view class="modal-mask" wx:if="{{showReviewModal}}" bindtap="closeReviewModal"></view>
  <view class="modal-container" wx:if="{{showReviewModal}}">
    <view class="modal-header">
      <text class="modal-title">评价服务</text>
      <view class="modal-close" bindtap="closeReviewModal">✕</view>
    </view>
    <view class="modal-content">
      <!-- 评分选择 -->
      <view class="rating-section">
        <text class="rating-label">服务评分：</text>
        <view class="rating-stars">
          <text 
            wx:for="{{[1, 2, 3, 4, 5]}}" 
            wx:key="*this"
            class="star {{currentRating >= index + 1 ? 'active' : ''}}"
            bindtap="selectRating" 
            data-rating="{{index + 1}}"
          >★</text>
        </view>
      </view>
      
      <!-- 评价内容 -->
      <view class="review-content-section">
        <text class="content-label">评价内容：</text>
        <textarea 
          class="review-textarea" 
          placeholder="请输入您的评价（选填）" 
          value="{{reviewContent}}" 
          bindinput="onReviewInput"
          maxlength="200"
        ></textarea>
        <text class="char-count">{{reviewContent.length}}/200</text>
      </view>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="closeReviewModal">取消</button>
      <button class="submit-btn" bindtap="submitReview" type="primary">提交评价</button>
    </view>
  </view>
</view>