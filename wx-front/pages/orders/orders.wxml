<!--orders.wxml-->
<view class="container">
  <!-- Tab栏 -->
  <view class="tab-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="id"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading && !orderList.length}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!loading && !orderList.length}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <!-- 订单卡片列表 -->
    <view 
      wx:for="{{orderList}}" 
      wx:key="id"
      class="order-card"
      bindtap="onOrderCardTap"
      data-id="{{item.id}}"
    >
      <!-- 订单头部：订单编号和状态 -->
      <view class="order-header">
        <view class="order-no">
          <text class="order-label">订单编号：</text>
          <text class="order-value">{{item.orderNo}}</text>
        </view>
        <view class="order-status" style="background-color: {{item.statusInfo.color}};">
          <text class="status-text">{{item.statusInfo.text}}</text>
        </view>
      </view>

      <!-- 订单内容：服务类型和金额 -->
      <view class="order-content">
        <view class="content-row">
          <text class="content-label">服务类型：</text>
          <text class="content-value">{{item.serviceName || item.serviceType}}</text>
        </view>
        <view class="content-row">
          <text class="content-label">服务金额：</text>
          <text class="content-value price">¥{{item.amount || item.price}}</text>
        </view>
      </view>

      <!-- 订单时间信息 -->
      <view class="order-time">
        <view class="time-row">
          <text class="time-label">服务开始：</text>
          <text class="time-value">{{item.startTimeFormatted}}</text>
        </view>
        <view class="time-row">
          <text class="time-label">服务结束：</text>
          <text class="time-value">{{item.endTimeFormatted}}</text>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <text class="order-date">{{item.createTime ? item.createTime.split(' ')[0] : ''}}</text>
      </view>
    </view>
  </view>

  <!-- 加载中指示器 -->
  <view class="refresh-indicator" wx:if="{{refreshing}}">
    <text class="refresh-text">刷新中...</text>
  </view>
  
  <!-- 加载更多指示器 -->
  <view class="load-more-indicator" wx:if="{{loadingMore}}">
    <text class="load-more-text">加载更多...</text>
  </view>
  
  <!-- 没有更多数据提示 -->
  <view class="no-more-indicator" wx:if="{{!loadingMore && !hasMore && orderList.length}}">
    <text class="no-more-text">没有更多了~</text>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="custom-tab-bar">
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/index/index">
      <view class="tab-icon">🏠</view>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-item active" bindtap="navigateToPage" data-page="pages/orders/orders">
      <view class="tab-icon">📋</view>
      <text class="tab-text">订单</text>
    </view>
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/profile/profile">
      <view class="tab-icon">👤</view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>