/* orders.wxss */

/* 页面容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f8f8;
  padding-bottom: 100rpx; /* 为底部菜单留出空间 */
  padding-top: 90rpx; /* 为固定的tab栏留出空间 */
}

/* Tab栏样式 - 固定在页面顶部 */
.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: white;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 0 10rpx;
  z-index: 99;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  position: relative;
  padding: 30rpx 0;
  text-align: center;
}

.tab-text {
  font-size: 32rpx;
  color: #666;
  transition: color 0.3s;
}

.tab-item.active .tab-text {
  color: #667eea;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #667eea;
  border-radius: 2rpx;
}

/* 订单列表容器 */
.order-list {
  flex: 1;
  padding: 0 10rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}



/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 订单卡片样式 */
.order-card {
  background-color: white;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s, box-shadow 0.2s;
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  display: flex;
  align-items: center;
}

.order-label {
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
}

.order-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.order-status {
  padding: 5rpx 20rpx;
  border-radius: 16rpx;
}

.status-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 订单内容 */
.order-content {
  margin-bottom: 20rpx;
}

.content-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.content-row:last-child {
  margin-bottom: 0;
}

.content-label {
  font-size: 28rpx;
  color: #666;
}

.content-value {
  font-size: 28rpx;
  color: #333;
}

.content-value.price {
  color: #ff6b6b;
  font-weight: bold;
  font-size: 32rpx;
}

/* 支付状态按钮样式 */
.payment-status-btn {
  height: 50rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #fff;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  touch-action: manipulation;
  cursor: pointer;
}

.payment-status-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 支付成功状态下的禁用样式 */
.payment-status-btn.disabled {
  cursor: not-allowed;
  opacity: 0.8;
}

.payment-status-btn.disabled:active {
  opacity: 0.8;
  transform: none;
}

/* 订单时间信息 */
.order-time {
  margin-bottom: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.time-row {
  display: flex;
  margin-bottom: 12rpx;
}

.time-row:last-child {
  margin-bottom: 0;
}

.time-label {
  font-size: 26rpx;
  color: #999;
  width: 130rpx;
}

.time-value {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-date {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮容器 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

/* 联系按钮样式 */
.contact-btn {
  padding: 0 20rpx;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: #52c41a;
  border-radius: 25rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  box-sizing: border-box;
  touch-action: manipulation;
}

.contact-btn:active {
  background-color: #73d13d;
}

/* 评价按钮样式 */
.review-btn {
  height: 50rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: #1890ff;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.review-btn:active {
  background-color: #40a9ff;
}

/* 退款按钮样式 */
.refund-btn {
  height: 50rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: #ff4d4f;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.refund-btn:active {
  background-color: #ff7875;
}

/* 刷新指示器 */
.refresh-indicator {
  position: fixed;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.7);
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  z-index: 999;
}

.refresh-text {
  color: white;
  font-size: 24rpx;
}

/* 自定义底部导航栏样式 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 998;
}

/* 单个导航项样式 */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

/* 导航图标样式 */
.tab-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 导航文字样式 */
.tab-text {
  font-size: 24rpx;
  color: #999999;
}

/* 选中状态样式 */
.tab-item.active .tab-text {
  color: #1AAD19;
  font-weight: bold;
}

/* 评价弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 500rpx;
  background-color: #fff;
  border-radius: 20rpx;
  z-index: 999;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-close:active {
  color: #666;
}

.modal-content {
  padding: 30rpx;
}

.rating-section {
  margin-bottom: 30rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.rating-stars {
  display: flex;
  gap: 10rpx;
}

.star {
  font-size: 50rpx;
  color: #ddd;
}

.star.active {
  color: #ff9800;
}

.review-content-section {
  margin-bottom: 20rpx;
}

.content-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.review-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.review-textarea:focus {
  border-color: #1890ff;
}

/* 退款申请弹窗样式 */
.refund-reason-section {
  margin-bottom: 20rpx;
}

.refund-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.refund-textarea:focus {
  border-color: #1890ff;
}

.char-count {
  font-size: 24rpx;
  color: #999;
  float: right;
  margin-top: 10rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  margin: 0;
}

.submit-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #1890ff;
  border-radius: 10rpx;
  margin: 0;
  color: #fff;
}

/* 页面内容底部内边距，避免被底部导航栏遮挡 */
.container {
  padding-bottom: 120rpx;
}