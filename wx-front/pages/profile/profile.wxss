/* 个人中心页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 100rpx; /* 为底部菜单留出空间 */
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

/* 用户信息区域 */
.user-info-section {
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 用户头像和基本信息 */
.user-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.avatar-container {
  margin-right: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #eee;
}

.user-basic-info {
  flex: 1;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.user-meta {
  font-size: 28rpx;
  color: #666;
  line-height: 40rpx;
}

.user-phone {
  display: block;
  margin-bottom: 8rpx;
}

.user-role {
  display: block;
}

/* 功能按钮区域 */
.button-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 30rpx;
  padding: 0 20rpx;
}

.primary-button {
  background: linear-gradient(135deg, #3199ff, #2b88e3);
  color: #fff;
  border-radius: 45rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 96rpx;
  height: 96rpx;
  box-shadow: 0 8rpx 20rpx rgba(49, 153, 255, 0.25);
  transition: all 0.3s ease;
}

.primary-button:active {
  background: linear-gradient(135deg, #2b88e3, #2277d4);
  box-shadow: 0 4rpx 10rpx rgba(49, 153, 255, 0.2);
  transform: translateY(2rpx);
}

.secondary-button {
  background-color: #fff;
  color: #555;
  border: 1rpx solid #e0e0e0;
  border-radius: 45rpx;
  font-size: 34rpx;
  line-height: 96rpx;
  height: 96rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.secondary-button:active {
  background-color: #f8f8f8;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transform: translateY(2rpx);
}

/* 用户详细信息区域 */
.user-details-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 30rpx;
  color: #666;
}

.detail-value {
  font-size: 30rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
  word-break: break-all;
}

/* 联系客服区域 */
.customer-service-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-top: 30rpx;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.service-item:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 30rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.service-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  color: #3199ff;
}

.service-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 自定义底部导航栏样式 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 998;
}

/* 单个导航项样式 */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

/* 导航图标样式 */
.tab-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 导航文字样式 */
.tab-text {
  font-size: 24rpx;
  color: #999999;
}

/* 选中状态样式 */
.tab-item.active .tab-text {
  color: #1AAD19;
  font-weight: bold;
}

/* 页面内容底部内边距，避免被底部导航栏遮挡 */
.container {
  padding-bottom: 120rpx;
}