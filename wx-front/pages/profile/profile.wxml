<!-- 个人中心页面 -->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 用户信息区域 -->
  <view class="user-info-section" wx:else>
    <!-- 用户头像和基本信息 -->
    <view class="user-header">
      <view class="avatar-container">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </view>
      <view class="user-basic-info">
        <text class="user-name">{{userInfo.name || '未设置'}}</text>
        <view class="user-meta">
          <text class="user-phone">{{userInfo.phone || '未设置'}}</text>
          <text class="user-role">角色：{{roleText}}</text>
        </view>
      </view>
    </view>

    <!-- 用户详细信息区域 -->
    <view class="user-details-section">
      <view class="detail-item">
        <text class="detail-label">用户ID：</text>
        <text class="detail-value">{{userInfo.id || '未知'}}</text>
      </view>
      <view class="detail-item" wx:if="{{userInfo.address}}">
        <text class="detail-label">地址：</text>
        <text class="detail-value">{{userInfo.address}}</text>
      </view>
      <view class="detail-item" wx:if="{{userInfo.age}}">
        <text class="detail-label">年龄：</text>
        <text class="detail-value">{{userInfo.age}}岁</text>
      </view>
      <view class="detail-item" wx:if="{{userInfo.serviceTypeId}}">
        <text class="detail-label">服务类型：</text>
        <text class="detail-value">{{userInfo.serviceTypeName || '加载中...'}}</text>
      </view>
    </view>
    
    <!-- 联系客服区域 -->
    <view class="customer-service-section">
      <view class="service-item" bindtap="contactCustomerService">
        <text class="service-icon">📞</text>
        <text class="service-label">联系客服</text>
        <text class="service-arrow">›</text>
      </view>
    </view>
    
    <!-- 功能按钮区域 -->
    <view class="button-section">
      <button class="primary-button" bindtap="goToEditProfile">修改信息</button>
      <button class="secondary-button" bindtap="logout">退出登录</button>
    </view>
  </view>

  <!-- 自定义底部导航栏 -->
  <view class="custom-tab-bar">
    <!-- 首页 -->
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/index/index">
      <view class="tab-icon">🏠</view>
      <text class="tab-text">首页</text>
    </view>
    <!-- 订单 -->
    <view class="tab-item" bindtap="navigateToPage" data-page="pages/orders/orders">
      <view class="tab-icon">📋</view>
      <text class="tab-text">订单</text>
    </view>
    <!-- 我的 -->
    <view class="tab-item active" bindtap="navigateToPage" data-page="pages/profile/profile">
      <view class="tab-icon">👤</view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>