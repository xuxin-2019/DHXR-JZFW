/* payment.wxss */

/* 页面容器 */
.payment-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 状态区域 */
.status-section {
  padding: 60rpx 0;
  text-align: center;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.status-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.error-message {
  font-size: 28rpx;
  color: #e64340;
  margin-top: 10rpx;
  padding: 0 40rpx;
  text-align: center;
}

/* 订单信息区域 */
.order-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  color: #666;
}

.value {
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

/* 总金额 */
.total-amount {
  font-weight: bold;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.total-amount .value {
  color: #e64340;
  font-size: 36rpx;
}

/* 倒计时区域 */
.countdown-section {
  background-color: #fff3f3;
  color: #e64340;
  padding: 20rpx;
  border-radius: 10rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.countdown-text {
  font-size: 28rpx;
}

/* 操作按钮区域 */
.action-section {
  padding: 20rpx 0;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

.loading-btn {
  background-color: #1aad19;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

/* 适配不同屏幕尺寸 */
@media screen and (min-width: 768px) {
  .payment-container {
    max-width: 768rpx;
    margin: 0 auto;
  }
}