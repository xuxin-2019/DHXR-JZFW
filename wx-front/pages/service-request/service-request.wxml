<!-- service-request.wxml -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-title">
    <text>服务预约</text>
  </view>
  
  <!-- 服务信息卡片 -->
  <view class="service-card">
    <view class="service-info">
      <view class="info-item">
        <text class="info-label">服务类型：</text>
        <text class="info-value">{{serviceName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务金额：</text>
        <text class="info-value price">¥{{servicePrice}}</text>
      </view>
      <view class="info-item" wx:if="serviceDuration > 0">
        <text class="info-label">服务时长：</text>
        <text class="info-value">{{serviceDuration}}分钟</text>
      </view>
    </view>
  </view>
  
  <!-- 服务申请表单 -->
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">服务地址 *</text>
      <textarea 
        class="form-input" 
        placeholder="请输入详细服务地址" 
        value="{{serviceAddress}}" 
        bindinput="onAddressChange"
        rows="3"
      ></textarea>
    </view>
    
    <view class="form-item">
      <text class="form-label">服务开始时间 *</text>
      <view class="time-picker-group">
        <!-- 开始日期选择器 -->
        <picker 
          class="form-picker date-picker"
          mode="date" 
          value="{{startDate}}" 
          start="{{currentDate}}"
          bindchange="onStartDateChange"
          fields="day"
        >
          <view class="picker-content">
            {{startDate ? startDate : '请选择日期'}}
          </view>
        </picker>
        
        <!-- 开始时间选择器 -->
        <picker 
          class="form-picker time-picker"
          mode="time" 
          value="{{startTimeHourMinute}}" 
          bindchange="onStartTimeChange"
        >
          <view class="picker-content">
            {{startTimeHourMinute ? startTimeHourMinute : '请选择时间'}}
          </view>
        </picker>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">服务结束时间 *</text>
      <view class="time-picker-group">
        <!-- 结束日期选择器 -->
        <picker 
          class="form-picker date-picker"
          mode="date" 
          value="{{endDate}}" 
          start="{{currentDate}}"
          bindchange="onEndDateChange"
          fields="day"
        >
          <view class="picker-content">
            {{endDate ? endDate : '请选择日期'}}
          </view>
        </picker>
        
        <!-- 结束时间选择器 -->
        <picker 
          class="form-picker time-picker"
          mode="time" 
          value="{{endTimeHourMinute}}" 
          bindchange="onEndTimeChange"
        >
          <view class="picker-content">
            {{endTimeHourMinute ? endTimeHourMinute : '请选择时间'}}
          </view>
        </picker>
      </view>
    </view>
  </view>
  
  <!-- 确认按钮 -->
  <view class="btn-container">
    <button 
      class="submit-btn" 
      type="primary" 
      bindtap="submitRequest" 
      disabled="{{loading}}"
      loading="{{loading}}"
    >
      确认预约
    </button>
  </view>
</view>