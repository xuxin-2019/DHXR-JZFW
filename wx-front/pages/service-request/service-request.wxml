<!-- service-request.wxml -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-title">
    <text>服务预约</text>
  </view>
  
  <!-- 服务信息卡片 -->
  <view class="service-card">
    <view class="service-info">
      <view class="info-item">
        <text class="info-label">服务类型：</text>
        <text class="info-value">{{serviceName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">期望服务金额：</text>
        <input 
          class="info-input price" 
          type="digit" 
          placeholder="请输入金额" 
          value="{{expectedPrice}}" 
          bindinput="onExpectedPriceChange"
        ></input>
      </view>
      <view class="info-item">
        <text class="info-label">期望服务时长：</text>
        <input 
          class="info-input" 
          type="number" 
          placeholder="请输入时长（分钟）" 
          value="{{expectedDuration}}" 
          bindinput="onExpectedDurationChange"
        ></input>
      </view>
    </view>
  </view>
  
  <!-- 服务申请表单 -->
  <view class="form-container">
    <view class="form-item">
      <text class="form-label">服务地址 *</text>
      <textarea 
        class="form-input" 
        placeholder="请输入详细服务地址" 
        value="{{serviceAddress}}" 
        bindinput="onAddressChange"
        rows="3"
      ></textarea>
    </view>
    
    <view class="form-item">
      <text class="form-label">期望服务时间 *</text>
      <view class="time-picker-group">
        <!-- 日期选择器 -->
        <picker 
          class="form-picker date-picker"
          mode="date" 
          value="{{expectedDate}}" 
          start="{{currentDate}}"
          bindchange="onExpectedDateChange"
          fields="day"
        >
          <view class="picker-content">
            {{expectedDate ? expectedDate : '请选择日期'}}
          </view>
        </picker>
        
        <!-- 时间选择器 -->
        <picker 
          class="form-picker time-picker"
          mode="time" 
          value="{{expectedTimeHourMinute}}" 
          bindchange="onExpectedTimeChange"
        >
          <view class="picker-content">
            {{expectedTimeHourMinute ? expectedTimeHourMinute : '请选择时间'}}
          </view>
        </picker>
      </view>
    </view>
  </view>
  
  <!-- 确认按钮 -->
  <view class="btn-container">
    <button 
      class="submit-btn" 
      type="primary" 
      bindtap="submitRequest" 
      disabled="{{loading}}"
      loading="{{loading}}"
    >
      确认预约
    </button>
  </view>
</view>