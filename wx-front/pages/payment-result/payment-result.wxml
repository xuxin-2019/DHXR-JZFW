<!-- payment-result.wxml -->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text class="loading-text">加载中...</text>
  </view>
  
  <!-- 页面错误状态 -->
  <view class="error-container" wx:elif="{{pageError}}">
    <view class="error-icon">!</view>
    <view class="error-text">{{pageErrorMessage}}</view>
    <button class="secondary-btn" bindtap="goToHome">返回首页</button>
  </view>
  
  <!-- 支付结果展示 -->
  <view wx:else>
    <view class="result-container">
      <!-- 支付成功状态 -->
      <view class="icon-container success-icon" wx:if="{{paymentStatus === 3}}">
        <text class="icon-text">✓</text>
      </view>
      
      <!-- 支付失败状态 -->
      <view class="icon-container fail-icon" wx:elif="{{paymentStatus === 4}}">
        <text class="icon-text">✕</text>
      </view>
      
      <!-- 支付中/待支付状态 -->
      <view class="icon-container processing-icon" wx:else>
        <text class="icon-text">⏳</text>
      </view>
      
      <!-- 结果标题 -->
      <view class="result-title">
        <block wx:if="{{paymentStatus === 3}}">支付成功</block>
        <block wx:elif="{{paymentStatus === 4}}">支付失败</block>
        <block wx:else>等待支付</block>
      </view>
      
      <!-- 支付状态描述 -->
      <view class="result-description" wx:if="{{paymentStatus === 4 && errorMsg}}">
        {{errorMsg}}
      </view>
      
      <!-- 倒计时显示 -->
      <view class="countdown" wx:if="{{paymentStatus === 1 || paymentStatus === 2}}">
        {{countdownText}}
      </view>
      
      <!-- 订单信息 -->
      <view class="order-info" wx:if="{{orderInfo}}">
        <view class="section-title">订单信息</view>
        <view class="info-item">
          <text class="info-label">订单号：</text>
          <text class="info-value">{{orderInfo.orderNo}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">支付金额：</text>
          <text class="info-value amount">¥{{orderInfo.totalAmount || '0.00'}}</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.serviceTypeName}}">
          <text class="info-label">服务类型：</text>
          <text class="info-value">{{orderInfo.serviceTypeName}}</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.serviceAddress}}">
          <text class="info-label">服务地址：</text>
          <text class="info-value">{{orderInfo.serviceAddress}}</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.serviceTime}}">
          <text class="info-label">服务时间：</text>
          <text class="info-value">{{orderInfo.serviceTime}}</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.serviceDuration}}">
          <text class="info-label">服务时长：</text>
          <text class="info-value">{{orderInfo.serviceDuration}}小时</text>
        </view>
      </view>
      
      <!-- 按钮区域 -->
      <view class="buttons-container">
        <!-- 支付成功 -->
        <view wx:if="{{paymentStatus === 3}}">
          <button class="primary-btn" bindtap="viewOrderDetail">查看订单详情</button>
          <button class="secondary-btn" bindtap="goToHome">返回首页</button>
        </view>
        
        <!-- 支付失败 -->
        <view wx:elif="{{paymentStatus === 4}}">
          <button class="primary-btn" bindtap="onRetryPayment">重新支付</button>
          <button class="secondary-btn" bindtap="goToHome">返回首页</button>
        </view>
        
        <!-- 支付中/待支付 -->
        <view wx:else>
          <button class="primary-btn" bindtap="onRetryPayment">立即支付</button>
          <button class="secondary-btn" bindtap="viewOrderDetail">查看订单</button>
        </view>
      </view>
    </view>
  </view>
</view>