/* payment-result.wxss */

.container {
  padding: 40rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #666;
  font-size: 28rpx;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  text-align: center;
}

.error-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 30rpx;
}

.error-text {
  color: #666;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}

/* 结果容器 */
.result-container {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 图标容器 */
.icon-container {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-icon {
  background-color: #52c41a;
}

.fail-icon {
  background-color: #ff4d4f;
}

.processing-icon {
  background-color: #1890ff;
}

.icon-text {
  color: #fff;
  font-size: 80rpx;
  line-height: 1;
}

/* 结果标题 */
.result-title {
  text-align: center;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 结果描述 */
.result-description {
  text-align: center;
  color: #ff4d4f;
  font-size: 32rpx;
  margin-bottom: 30rpx;
}

/* 倒计时 */
.countdown {
  text-align: center;
  color: #1890ff;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  font-weight: 500;
}

/* 订单信息 */
.order-info {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
}

.info-value.amount {
  color: #ff4d4f;
  font-size: 36rpx;
  font-weight: bold;
}

/* 按钮区域 */
.buttons-container {
  margin-top: 60rpx;
}

.buttons-container button {
  margin-bottom: 30rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.primary-btn {
  background-color: #1890ff;
  color: #fff;
  border: none;
}

.secondary-btn {
  background-color: #f0f0f0;
  color: #666;
  border: none;
}