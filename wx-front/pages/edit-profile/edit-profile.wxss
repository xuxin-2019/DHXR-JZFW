/* 修改个人信息页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 100rpx; /* 为底部菜单留出空间 */
}

/* 页面标题区域 */
.page-header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.role-info {
  font-size: 28rpx;
  color: #666;
}

/* 表单容器 */
.form-container {
  background-color: #fff;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 32rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  padding: 0;
}

.form-input::placeholder {
  color: #999;
  font-size: 32rpx;
}

/* 选择器样式 */
.form-picker {
  flex: 1;
}

.picker-display {
  font-size: 32rpx;
  color: #333;
  text-align: right;
}

/* 按钮区域 */
.button-section {
  padding: 0 30rpx;
}

.submit-button {
  background-color: #3199ff;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  line-height: 90rpx;
  height: 90rpx;
}

.submit-button:active {
  background-color: #1a88e5;
}

.submit-button[disabled] {
  background-color: #ccc;
  color: #fff;
}