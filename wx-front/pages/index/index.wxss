/**index.wxss**/
/* 页面容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f8f8;
  padding-bottom: 100rpx; /* 为底部菜单留出空间 */
}

/* 自定义底部导航栏样式 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 998;
}

/* 单个导航项样式 */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

/* 导航图标样式 */
.tab-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 导航文字样式 */
.tab-text {
  font-size: 24rpx;
  color: #999999;
}

/* 选中状态样式 */
.tab-item.active .tab-text {
  color: #1AAD19;
  font-weight: bold;
}

/* 页面内容底部内边距，避免被底部导航栏遮挡 */
.container {
  padding-bottom: 120rpx !important;
}

/* 登录按钮容器样式 */
.header {
  position: fixed;
  top: 20rpx;
  right: 20rpx;
  z-index: 999;
}

/* 登录按钮样式 */
.login-btn {
  background-color: #667eea;
  color: white;
  font-size: 24rpx;
  height: 70rpx;
  padding: 0 30rpx;
  border-radius: 35rpx;
  line-height: 70rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 页面标题 */
.page-title {
  text-align: center;
  margin: 60rpx 0 40rpx;
  padding-top: 100rpx; /* 为固定的登录按钮留出空间 */
}

.page-title text {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

/* 通用区块标题 */
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin: 40rpx 30rpx 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #eee;
}

/* 服务类型区域 */
.service-types {
  width: 100%;
}

.types-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 30rpx;
}

.service-type {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.type-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
}

.service-type:active .type-icon {
  transform: scale(0.95);
}

.icon-text {
  font-size: 48rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333;
}

/* 服务内容表格区域 */
.service-content {
  width: 100%;
  margin-top: 20rpx;
}

.content-table {
  background-color: white;
  margin: 0 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.table-header {
  display: flex;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.header-cell {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
}

.table-body {
  font-size: 26rpx;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
  color: #666;
}

.detail-cell {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price-cell {
  color: #ff6b6b;
  font-weight: bold;
}

/* 用户评价区域 */
.user-reviews {
  width: 100%;
  margin-top: 20rpx;
}

.review-list {
  padding: 0 30rpx;
}

.review-item {
  background-color: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.reviewer-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: #667eea;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.reviewer-info {
  flex: 1;
}

.reviewer-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.review-date {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}

.review-rating {
  color: #ffcc00;
  font-size: 24rpx;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部菜单栏 */
.footer-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: white;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.nav-item.active {
  color: #667eea;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.nav-text {
  font-size: 24rpx;
}
