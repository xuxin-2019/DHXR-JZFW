/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/**
 * 全局样式
 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  background-color: #f5f5f5;
}

/**
 * TabBar 美化样式
 */
.tab-bar {
  box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.08);
  background-color: #ffffff;
}

/* 优化tabBar项的样式 */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  transition: all 0.3s ease;
}

/* 图标样式优化 */
.tab-bar-item image {
  margin-bottom: 4rpx;
  width: 56rpx;
  height: 56rpx;
  transition: transform 0.2s ease;
}

/* 文字样式优化 */
.tab-bar-item .tab-bar-text {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 选中状态的额外效果 */
.tab-bar-item.active image {
  transform: scale(1.1);
}

.tab-bar-item.active .tab-bar-text {
  font-weight: 600;
}
